# systemd unit to run SmartFridge Vision as a service on Raspberry Pi (or the
# x86 "Raspberry Pi Desktop" running in VirtualBox) — anything Debian + systemd.
#
# It runs the app under gunicorn, starts it on boot, and restarts it on crash —
# the same behaviour you'll want on real Pi hardware.
#
# Install (run inside the guest, after cloning the repo and creating the .venv):
#   1. Replace every <user> below with your Linux username (what `whoami` prints)
#      and make sure the three paths match where you cloned the repo.
#   2. sudo cp deploy/smartfridge.service /etc/systemd/system/smartfridge.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now smartfridge
#   5. systemctl status smartfridge        # confirm it's active (running)
#      journalctl -u smartfridge -f         # follow its logs
#
# The app then serves on port 5000 for the whole machine (0.0.0.0). VISION_API_KEY
# and any TURSO_*/DATABASE_PATH settings are read from the repo's .env (never
# committed). Leave TURSO_* unset to use a local SQLite file on the device.

[Unit]
Description=SmartFridge Vision
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/capstone
EnvironmentFile=/home/<user>/capstone/.env
ExecStart=/home/<user>/capstone/.venv/bin/gunicorn --bind 0.0.0.0:5000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
