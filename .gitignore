# Secrets — never commit
.env

# Local database (inventory history) — data, don't commit
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code — ignore local session artifacts, keep the shared launch config
.claude/*
!.claude/launch.json
